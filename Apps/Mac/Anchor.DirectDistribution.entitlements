<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Entitlements for the Developer ID (direct download) build.

  iCloud and app groups are restricted entitlements, so this file is paired with
  the `Anchor Developer ID` provisioning profile. Sign in with Apple remains an
  App Store-only entitlement; the direct build keeps Google account connection
  and production CloudKit sync.
-->
<dict>
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.significanthobbies.anchor</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.significanthobbies.anchor</string>
	</array>
</dict>
</plist>
