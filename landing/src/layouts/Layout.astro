---
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = 'https://anchor.significanthobbies.com';
const canonical = new URL(Astro.url.pathname, site).href.replace(/\/$/, '') || site;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0c10" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anchor" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/shots/session.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='11' fill='none' stroke='%233b82f6' stroke-width='3'/%3E%3Ccircle cx='16' cy='5' r='3' fill='%237dd3fc'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <div class="wrap">
      <header class="site-head">
        <a class="brand" href="/">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="11" fill="none" stroke="#3b82f6" stroke-width="3"></circle>
            <circle cx="16" cy="5" r="3" fill="#7dd3fc"></circle>
          </svg>
          Anchor
        </a>
        <nav>
          <a href="/support">Support</a>
          <a href="/privacy">Privacy</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer>
        <span>Anchor — a Significant Hobbies app.</span>
        <span>
          <a href="/support">Support</a> · <a href="/privacy">Privacy</a> ·
          <a href="mailto:hello@significanthobbies.com">hello@significanthobbies.com</a>
        </span>
      </footer>
    </div>
  </body>
</html>
